# ─────────────────────────────────────────────────────────────
# QCafe — Environment Configuration
# Copy this file to .env.local (development) or configure these
# same keys as Environment Variables in your Vercel project.
# Nothing in this app is hardcoded — changing these values here
# is the ONLY way anything should change.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── App Identity ────────────────────────────────────────────
# Drives: navbar, logo, footer, SEO, metadata, emails, dashboard,
# admin panel, browser title, favicon, Open Graph, manifest, PWA,
# invoices, order emails, notifications, loading screen.
APP_NAME=QCafe
APP_TAGLINE="Fresh food, delivered fast"
APP_URL=http://localhost:3000
APP_DESCRIPTION="Order delicious food online from QCafe"
SUPPORT_EMAIL=support@example.com

# ── Database (MongoDB Atlas) ────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qcafe?retryWrites=true&w=majority

# ── Auth / JWT ───────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ── SMTP (Nodemailer) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_NAME=QCafe
SMTP_FROM_EMAIL=no-reply@example.com

# ── ImageKit ─────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Security ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Business Defaults (overridable from Admin → Restaurant Settings) ──
DEFAULT_CURRENCY=INR
DEFAULT_DELIVERY_FEE=0
DEFAULT_MIN_ORDER_VALUE=0
DEFAULT_TAX_PERCENT=5

# ── Future integrations (architecture-ready, not active yet) ──
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WHATSAPP_API_TOKEN=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
